<section class="py-4 py-lg-5" aria-labelledby="selected-project-title">
    <div class="container">
        <div class="d-flex align-items-end justify-content-between gap-3 mb-4 mb-lg-5">
            <div>
                <p class="msn-hero-kicker mb-2">@Localizer["SelectedProject_Kicker"]</p>
                <h2 class="msn-section-title mb-0" id="selected-project-title">
                    @Localizer["SelectedProject_SectionTitle"]
                </h2>
            </div>

            <a class="btn msn-projects-cta d-none d-sm-inline-flex align-items-center justify-content-center"
               href="#"
               data-preview-link>
                <span>@Localizer["SelectedProject_ViewAll"]</span>
                <span class="msn-projects-cta-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18">
                        <path d="M7 12h10M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                </span>
            </a>
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3 align-items-start" id="projectsAccordion">
            @foreach (var project in projects)
            {
                var detailsId = $"{project.Id}-project-details";

                <div class="col">
                    <article class="msn-project-card overflow-hidden">
                        <div class="msn-project-preview position-relative">
                            <img src="~/assets/projects/ziggurat-placeholder.svg"
                                 alt="@Localizer["Projects_PreviewAlt", project.Name]"
                                 class="w-100 d-block"
                                 loading="lazy" />

                            <div class="msn-project-live-badge">
                                <span class="@(project.IsLive ? "msn-project-live-dot" : "msn-project-demo-dot")"
                                      aria-hidden="true"></span>
                                <span>
                                    @(project.IsLive ? Localizer["SelectedProject_Live"] : Localizer["Projects_Demo"])
                                </span>
                            </div>
                        </div>

                        <div class="p-3">
                            <div class="d-flex align-items-start justify-content-between gap-3">
                                <div class="min-w-0">
                                    <p class="msn-project-label mb-2">@project.Lead</p>
                                    <h3 class="msn-project-title mb-2">@project.Name</h3>
                                    <p class="msn-project-subtitle mb-0">@project.Subtitle</p>
                                </div>

                                <button class="btn msn-project-toggle rounded-circle d-inline-flex align-items-center justify-content-center flex-shrink-0"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#@detailsId"
                                        aria-expanded="false"
                                        aria-controls="@detailsId"
                                        aria-label="@Localizer["Projects_ToggleLabel", project.Name]">
                                    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                                        <path d="M6 9l6 6 6-6"
                                              fill="none"
                                              stroke="currentColor"
                                              stroke-width="2.2"
                                              stroke-linecap="round"
                                              stroke-linejoin="round"></path>
                                    </svg>
                                </button>
                            </div>
                        </div>

                        <div class="collapse" id="@detailsId" data-bs-parent="#projectsAccordion">
                            <div class="border-top border-secondary border-opacity-25 p-3">
                                <p class="msn-hero-description mb-4">
                                    @project.Description
                                </p>

                                <div class="d-flex flex-wrap gap-2 mb-4"
                                     aria-label="@Localizer["SelectedProject_TechnologiesLabel"]">
                                    <span class="msn-project-tech">ASP.NET Core</span>
                                    <span class="msn-project-tech">EF Core</span>
                                    <span class="msn-project-tech">SQL Server</span>
                                    <span class="msn-project-tech">Bootstrap</span>
                                    <span class="msn-project-tech">JavaScript</span>
                                </div>

                                @if (project.IsLive)
                                {
                                    <a class="btn msn-project-action w-100"
                                       href="@project.Url"
                                       target="_blank"
                                       rel="noopener noreferrer">
                                        @Localizer["SelectedProject_ViewProject"]
                                    </a>
                                }
                                else
                                {
                                    <a class="btn msn-project-action w-100"
                                       href="#"
                                       data-preview-link>
                                        @Localizer["Projects_DemoButton"]
                                    </a>
                                }
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>

        <div class="d-sm-none mt-4">
            <a class="btn msn-projects-cta w-100 d-inline-flex align-items-center justify-content-center"
               href="#"
               data-preview-link>
                <span>@Localizer["SelectedProject_ViewAll"]</span>
                <span class="msn-projects-cta-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18">
                        <path d="M7 12h10M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                </span>
            </a>
        </div>

        <div class="msn-section-divider-wrap" aria-hidden="true">
            <span class="msn-section-divider"></span>
        </div>
    </div>
</section>


