@using System.Globalization
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    var culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa" ? "fa" : "en";
    var homeUrl = $"/{culture}";

    var parts = (Context.Request.Path.Value ?? "/")
        .Split('/', StringSplitOptions.RemoveEmptyEntries)
        .ToList();

    if (parts.Count > 0 && (parts[0].Equals("fa", StringComparison.OrdinalIgnoreCase) ||
                            parts[0].Equals("en", StringComparison.OrdinalIgnoreCase)))
    {
        parts.RemoveAt(0);
    }

    var suffix = parts.Count == 0 ? string.Empty : "/" + string.Join("/", parts);
    var query = Context.Request.QueryString.HasValue ? Context.Request.QueryString.Value : string.Empty;
    var faUrl = "/fa" + suffix + query;
    var enUrl = "/en" + suffix + query;
}
<!DOCTYPE html>
<html lang="@culture" dir="@(isRtl ? "rtl" : "ltr")" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - MSNiknam</title>

    @if (isRtl)
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    }
    else
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="msn-header sticky-top">
        <nav class="navbar py-0" aria-label="@Localizer["Header_MainNavigation"]">
            <div class="container d-flex align-items-center justify-content-between">
                <a class="msn-brand" href="@homeUrl" aria-label="@Localizer["Header_HomeLabel"]">
                    <img class="msn-brand-logo msn-logo-dark" src="~/assets/brand/msniknam-wordmark-white.svg" alt="MSNiknam" />
                    <img class="msn-brand-logo msn-logo-light" src="~/assets/brand/msniknam-wordmark-black.svg" alt="MSNiknam" />
                </a>

                <div class="d-none d-lg-flex align-items-center mx-auto msn-main-nav-links">
                    <a class="msn-nav-link active" href="@homeUrl">
                        <span class="msn-nav-link-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10.5 12 4l8 6.5V20H4z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M9.5 20v-5h5v5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg></span>
                        <span>@Localizer["Nav_Home"]</span>
                    </a>
                    <a class="msn-nav-link" href="#" data-preview-link>
                        <span class="msn-nav-link-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M5.7 19c1.5-3 3.8-4.4 6.3-4.4s4.8 1.4 6.3 4.4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span>
                        <span>@Localizer["Nav_About"]</span>
                    </a>
                    <a class="msn-nav-link" href="#" data-preview-link>
                        <span class="msn-nav-link-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3.8h7l4 4V20H7z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M14 3.8V8h4M9 12h6M9 15h6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span>
                        <span>@Localizer["Nav_Resume"]</span>
                    </a>
                    <a class="msn-nav-link" href="#" data-preview-link>
                        <span class="msn-nav-link-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="6.5" height="6.5" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.8"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.8"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.8"/><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.8"/></svg></span>
                        <span>@Localizer["Nav_Projects"]</span>
                    </a>
                    <a class="msn-nav-link" href="#" data-preview-link>
                        <span class="msn-nav-link-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8.5h16V19H4z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M9 8.5V6.8c0-.9.7-1.6 1.6-1.6h2.8c.9 0 1.6.7 1.6 1.6v1.7M4 12h16" fill="none" stroke="currentColor" stroke-width="1.8"/></svg></span>
                        <span>@Localizer["Nav_Services"]</span>
                    </a>
                    <a class="msn-nav-link" href="#" data-preview-link>
                        <span class="msn-nav-link-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5h10.5A1.5 1.5 0 0 1 18 6.5V18H7.5A1.5 1.5 0 0 1 6 16.5z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M8.5 9h7M8.5 12h7M8.5 15h4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span>
                        <span>@Localizer["Nav_Blog"]</span>
                    </a>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <div class="dropdown">
                        <button class="btn msn-control dropdown-toggle" type="button" data-bs-toggle="dropdown"
                                aria-expanded="false" aria-label="@Localizer["Header_Language"]"
                                title="@Localizer["Header_Language"]">
                            <svg class="msn-icon" viewBox="0 0 24 24" aria-hidden="true">
                                <circle cx="12" cy="12" r="9"></circle>
                                <path d="M3 12h18M12 3c2.2 2.5 3.3 5.5 3.3 9S14.2 18.5 12 21M12 3C9.8 5.5 8.7 8.5 8.7 12s1.1 6.5 3.3 9"></path>
                            </svg>
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end msn-language-menu">
                            <li>
                                <a class="dropdown-item msn-language-option @(culture == "en" ? "active" : string.Empty)"
                                   href="@enUrl" lang="en" dir="ltr">
                                    <span>@Localizer["Language_English"]</span><span class="msn-language-dot"></span>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item msn-language-option @(culture == "fa" ? "active" : string.Empty)"
                                   href="@faUrl" lang="fa" dir="rtl">
                                    <span>@Localizer["Language_Persian"]</span><span class="msn-language-dot"></span>
                                </a>
                            </li>
                        </ul>
                    </div>

                    <button class="btn msn-control msn-theme-button" type="button"
                            aria-label="@Localizer["Header_Theme"]" title="@Localizer["Header_Theme"]" aria-pressed="false">
                        <svg class="msn-icon msn-moon" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M20.4 15.4A8.5 8.5 0 0 1 8.6 3.6 8.5 8.5 0 1 0 20.4 15.4Z"></path>
                        </svg>
                        <svg class="msn-icon msn-sun" viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="12" cy="12" r="4"></circle>
                            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
                        </svg>
                    </button>

                    <a class="btn msn-control msn-header-contact d-none d-lg-inline-flex px-3 gap-2" href="#" data-preview-link>
                        <span class="msn-header-contact-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 6.5h15v11h-15z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="m5 7 7 5 7-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg></span>
                        <span>@Localizer["Nav_Contact"]</span>
                    </a>

                    <button class="btn msn-control d-inline-flex d-lg-none msn-menu-button" type="button"
                            data-bs-toggle="offcanvas" data-bs-target="#msnMobileMenu"
                            aria-controls="msnMobileMenu" aria-label="@Localizer["Header_OpenMenu"]">
                        <span></span><span></span><span></span>
                    </button>
                </div>
            </div>
        </nav>
    </header>

    <div class="offcanvas @(isRtl ? "offcanvas-start" : "offcanvas-end") msn-mobile-menu" tabindex="-1"
         id="msnMobileMenu" aria-labelledby="msnMobileMenuLabel">
        <div class="offcanvas-header">
            <span class="visually-hidden" id="msnMobileMenuLabel">@Localizer["Header_MobileNavigation"]</span>
            <button type="button" class="btn-close msn-close" data-bs-dismiss="offcanvas"
                    aria-label="@Localizer["Header_CloseMenu"]"></button>
        </div>
        <div class="offcanvas-body">
            <nav class="nav flex-column">
                <a class="nav-link msn-mobile-link active" href="@homeUrl"><span class="msn-mobile-link-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10.5 12 4l8 6.5V20H4z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M9.5 20v-5h5v5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg></span><span>@Localizer["Nav_Home"]</span></a>
                <a class="nav-link msn-mobile-link" href="#" data-preview-link><span class="msn-mobile-link-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M5.7 19c1.5-3 3.8-4.4 6.3-4.4s4.8 1.4 6.3 4.4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span><span>@Localizer["Nav_About"]</span></a>
                <a class="nav-link msn-mobile-link" href="#" data-preview-link><span class="msn-mobile-link-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3.8h7l4 4V20H7z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M14 3.8V8h4M9 12h6M9 15h6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span><span>@Localizer["Nav_Resume"]</span></a>
                <a class="nav-link msn-mobile-link" href="#" data-preview-link><span class="msn-mobile-link-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="6.5" height="6.5" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.8"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.8"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.8"/><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.8"/></svg></span><span>@Localizer["Nav_Projects"]</span></a>
                <a class="nav-link msn-mobile-link" href="#" data-preview-link><span class="msn-mobile-link-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8.5h16V19H4z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M9 8.5V6.8c0-.9.7-1.6 1.6-1.6h2.8c.9 0 1.6.7 1.6 1.6v1.7M4 12h16" fill="none" stroke="currentColor" stroke-width="1.8"/></svg></span><span>@Localizer["Nav_Services"]</span></a>
                <a class="nav-link msn-mobile-link" href="#" data-preview-link><span class="msn-mobile-link-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5h10.5A1.5 1.5 0 0 1 18 6.5V18H7.5A1.5 1.5 0 0 1 6 16.5z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M8.5 9h7M8.5 12h7M8.5 15h4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span><span>@Localizer["Nav_Blog"]</span></a>
                <a class="btn msn-control msn-mobile-contact mt-4 gap-2" href="#" data-preview-link><span class="msn-mobile-link-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 6.5h15v11h-15z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="m5 7 7 5 7-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg></span><span>@Localizer["Nav_Contact"]</span></a>
            </nav>
        </div>
    </div>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="msn-footer mt-4">
        <div class="container">
            <div class="msn-footer-top">
                <div class="msn-footer-brand-panel">
                    <a class="msn-brand msn-footer-brand"
                       href="@homeUrl"
                       aria-label="@Localizer["Header_HomeLabel"]">
                        <img class="msn-brand-logo msn-logo-dark"
                             src="~/assets/brand/msniknam-wordmark-white.svg"
                             alt="MSNiknam" />
                        <img class="msn-brand-logo msn-logo-light"
                             src="~/assets/brand/msniknam-wordmark-black.svg"
                             alt="MSNiknam" />
                    </a>

                    <span class="msn-footer-accent" aria-hidden="true"></span>

                    <p class="msn-footer-tagline mb-0">
                        @Localizer["Footer_Tagline"]
                    </p>
                </div>

                <nav class="msn-footer-menu"
                     aria-label="@Localizer["Footer_Navigation"]">
                    <a class="msn-footer-menu-link" href="@homeUrl">
                                    <span class="msn-footer-link-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10.5 12 4l8 6.5V20H4z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M9.5 20v-5h5v5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg></span>
                                    <span>@Localizer["Nav_Home"]</span>
                                </a>
                    <a class="msn-footer-menu-link" href="#" data-preview-link>
                                    <span class="msn-footer-link-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M5.7 19c1.5-3 3.8-4.4 6.3-4.4s4.8 1.4 6.3 4.4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span>
                                    <span>@Localizer["Nav_About"]</span>
                                </a>
                    <a class="msn-footer-menu-link" href="#" data-preview-link>
                                    <span class="msn-footer-link-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3.8h7l4 4V20H7z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M14 3.8V8h4M9 12h6M9 15h6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span>
                                    <span>@Localizer["Nav_Resume"]</span>
                                </a>
                    <a class="msn-footer-menu-link" href="#" data-preview-link>
                                    <span class="msn-footer-link-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="6.5" height="6.5" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.8"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.8"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.8"/><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.8"/></svg></span>
                                    <span>@Localizer["Nav_Projects"]</span>
                                </a>
                    <a class="msn-footer-menu-link" href="#" data-preview-link>
                                    <span class="msn-footer-link-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8.5h16V19H4z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M9 8.5V6.8c0-.9.7-1.6 1.6-1.6h2.8c.9 0 1.6.7 1.6 1.6v1.7M4 12h16" fill="none" stroke="currentColor" stroke-width="1.8"/></svg></span>
                                    <span>@Localizer["Nav_Services"]</span>
                                </a>
                    <a class="msn-footer-menu-link" href="#" data-preview-link>
                                    <span class="msn-footer-link-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5h10.5A1.5 1.5 0 0 1 18 6.5V18H7.5A1.5 1.5 0 0 1 6 16.5z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M8.5 9h7M8.5 12h7M8.5 15h4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span>
                                    <span>@Localizer["Nav_Blog"]</span>
                                </a>
                    <a class="msn-footer-menu-link" href="#" data-preview-link>
                                    <span class="msn-footer-link-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5.5" y="10.5" width="13" height="9" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M8.5 10.5V8.7A3.5 3.5 0 0 1 12 5.2a3.5 3.5 0 0 1 3.5 3.5v1.8" fill="none" stroke="currentColor" stroke-width="1.8"/></svg></span>
                                    <span>@Localizer["Footer_Privacy"]</span>
                                </a>
                </nav>

                <div class="msn-footer-actions">
                    <a class="msn-footer-contact" href="#" data-preview-link>
                        <span class="msn-footer-contact-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 6.5h15v11h-15z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="m5 7 7 5 7-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg></span>
                        <span>@Localizer["Nav_Contact"]</span>
                    </a>

                    <div class="msn-footer-socials">
                        <a class="msn-footer-social"
                           href="https://github.com/MSNiknam"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="GitHub"
                           title="GitHub">
                            <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
                                <path fill="currentColor" d="M12 .8A11.2 11.2 0 0 0 8.5 22.6c.56.1.77-.24.77-.54v-2.1c-3.12.68-3.78-1.32-3.78-1.32-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.72 1.16 1.72 1.16 1 1.72 2.63 1.22 3.27.93.1-.73.39-1.22.71-1.5-2.49-.28-5.11-1.25-5.11-5.55 0-1.23.44-2.23 1.16-3.02-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.08 1.15A10.7 10.7 0 0 1 12 6.1c.95 0 1.9.13 2.79.38 2.13-1.44 3.07-1.15 3.07-1.15.62 1.55.23 2.7.12 2.98.72.79 1.15 1.8 1.15 3.02 0 4.31-2.62 5.26-5.12 5.54.4.35.76 1.03.76 2.07v3.08c0 .3.2.65.77.54A11.2 11.2 0 0 0 12 .8Z"/>
                            </svg>
                        </a>

                        <a class="msn-footer-social"
                           href="https://www.linkedin.com/in/mohammadsaleh-niknam-08b859259/"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="LinkedIn"
                           title="LinkedIn">
                            <span class="fw-bold" aria-hidden="true">in</span>
                        </a>

                        <a class="msn-footer-social"
                           href="https://www.instagram.com/MSNiknam/"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="Instagram"
                           title="Instagram">
                            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                <rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect>
                                <circle cx="12" cy="12" r="4"></circle>
                                <circle cx="17.4" cy="6.7" r="1" fill="currentColor" stroke="none"></circle>
                            </svg>
                        </a>

                        <a class="msn-footer-social"
                           href="https://t.me/MSNiknam"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="Telegram"
                           title="Telegram">
                            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true">
                                <path d="M21 4 3.8 10.6c-.8.3-.8 1.4.1 1.6l4.4 1.3 1.7 5c.3.8 1.3 1 1.8.3l2.5-3.1 4.1 3c.6.4 1.4.1 1.5-.7L22 5.2c.2-.9-.3-1.5-1-1.2Z"></path>
                                <path d="m8.3 13.5 8.9-5.9"></path>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>

            <div class="msn-footer-bottom">
                <span>© @DateTime.UtcNow.Year MSNiknam. @Localizer["Footer_Rights"]</span>
                <span>@Localizer["Footer_Credit"]</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
